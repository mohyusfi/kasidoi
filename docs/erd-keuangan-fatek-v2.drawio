        <mxCell id="exp_box_summary" parent="exp_root_1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;align=left;verticalAlign=top;spacing=12;arcSize=4;" value="&lt;b style=&quot;font-size: 15px; color: #0F172A;&quot;&gt;Keunggulan Arsitektur Domain Eksplisit (Sinkron 100% dengan CSV PKKM &amp;amp; V2 Clean):&lt;/b&gt;&lt;br&gt;&lt;ol style=&quot;margin-top: 8px; padding-left: 20px; font-size: 11px; color: #334155; line-height: 1.55;&quot;&gt;&lt;li&gt;&lt;b&gt;Pemisahan Komponen (059) vs Subkomponen Prodi (AA/BA/DA):&lt;/b&gt; &lt;i&gt;components&lt;/i&gt; (Level 4) memegang payung program fakultas/universitas, sedangkan &lt;i&gt;activities&lt;/i&gt; (Level 5) menampung kegiatan subkomponen milik Prodi yang terikat ke &lt;b&gt;id_unit&lt;/b&gt; pelaksana.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Pohon Program Utuh (4471 &amp;rarr; 4471.BEI &amp;rarr; 4471.BEI.001):&lt;/b&gt; Menampung rantai Program &amp;rarr; Kegiatan (KRO) &amp;rarr; Rincian Output (RO) via &lt;i&gt;parent_program_id&lt;/i&gt; &amp;amp; &lt;i&gt;level_type&lt;/i&gt; tanpa perlu hardcode array di TypeScript.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Multi-Factor Kuantitas Belanja (rab_items):&lt;/b&gt; Rumus perkalian volume bertahap (&lt;i&gt;kuantitas &amp;times; durasi = total_volume&lt;/i&gt; dikali &lt;i&gt;harga_satuan = pagu_awal&lt;/i&gt;) tersimpan rapi beserta &lt;i&gt;kode_item&lt;/i&gt; dan &lt;i&gt;link_ekatalog&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Single Source of Truth Pagu:&lt;/b&gt; Menghapus kolom &lt;i&gt;total_anggaran&lt;/i&gt; redundan di tabel induk (programs, components, activities, accounts, sub_accounts) serta tabel &lt;i&gt;total_pagus&lt;/i&gt;. Seluruh pagu dihitung dinamis dari &lt;b&gt;SUM(rab_items.pagu_awal)&lt;/b&gt; sehingga mustahil desync/minus.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Organisasi Fleksibel (units):&lt;/b&gt; Hirarki Fakultas &amp;rarr; Jurusan &amp;rarr; Prodi mandiri via &lt;i&gt;parent_unit_id&lt;/i&gt;. Pengguna (&lt;i&gt;users&lt;/i&gt;) dipisahkan dari unit kerja, menjaga integritas historis keuangan saat staf berganti.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Standar Presisi Finansial:&lt;/b&gt; Seluruh uang memakai &lt;b&gt;DECIMAL(15,2)&lt;/b&gt; (aman di atas Rp 2,14 Miliar) dan status memakai &lt;b&gt;ENUM&lt;/b&gt;.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="480" width="740" x="1035" y="243" as="geometry" />
        </mxCell>
        <mxCell id="exp_edge_unit_self" edge="1" parent="exp_root_1" source="exp_un_2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;fontColor=#0D9488;fontSize=11;labelBackgroundColor=#FFFFFF;fontStyle=1;" target="exp_un_1" value="Induk Unit (1:N)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-35" y="472" />
              <mxPoint x="-35" y="442" />
            </Array>
          </mxGeometry>
        </mxCell>
