        <mxCell id="box_info" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;align=left;verticalAlign=top;spacing=12;arcSize=4;" value="&lt;b style=&quot;font-size: 14px; color: #0F172A;&quot;&gt;Arsitektur &amp;amp; Alur Data Sistem Keuangan Fatek:&lt;/b&gt;&lt;br&gt;&lt;ul style=&quot;margin-top: 6px; padding-left: 20px; font-size: 11px; color: #334155;&quot;&gt;&lt;li&gt;&lt;b&gt;Plafon &amp;amp; Payung Utama:&lt;/b&gt; &lt;i&gt;laporans&lt;/i&gt; menyimpan total pagu tahunan (BOPTN &amp;amp; BLU). Dikontrol per paket lewat &lt;i&gt;rabs&lt;/i&gt;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Hierarki Anggaran PKKM:&lt;/b&gt; Disusun bertingkat (&lt;i&gt;Program&lt;/i&gt; &amp;rarr; &lt;i&gt;Unit/Prodi&lt;/i&gt; &amp;rarr; &lt;i&gt;Activity&lt;/i&gt; &amp;rarr; &lt;i&gt;Account&lt;/i&gt; &amp;rarr; &lt;i&gt;SubAccount&lt;/i&gt; &amp;rarr; &lt;i&gt;ItemDetail&lt;/i&gt;).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Ledger Master Dana:&lt;/b&gt; &lt;i&gt;kode_uang_masters&lt;/i&gt; mengikat baris rincian &lt;i&gt;ItemDetail&lt;/i&gt; dengan alokasi &lt;i&gt;pagu_awal&lt;/i&gt;, revisi, realisasi, dan sisa pagu.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Alur Pencairan (Cash Outflow):&lt;/b&gt; Unit mengajukan &lt;i&gt;rpds&lt;/i&gt; mengacu pada pos kegiatan (&lt;i&gt;Activity&lt;/i&gt;), dicairkan uang muka (&lt;i&gt;panjars&lt;/i&gt;), lalu dipertanggungjawabkan melalui kuitansi fisik (&lt;i&gt;lpjs&lt;/i&gt;).&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="200" width="370" x="1181" y="-105" as="geometry" />
